`timescale 1ns/1ps

module tb_prime_counter;

    reg clk, rst, start, stop;
    wire [1:0] state;
    wire [3:0] count;

    prime_counter uut (
        .clk(clk),
        .rst(rst),
        .start(start),
        .stop(stop),
        .state(state),
        .count(count)
    );

    always #5 clk = ~clk;

    initial begin
      $dumpfile("dump.vcd");
      $dumpvars(0, tb_prime_counter);
        clk = 0;
        rst = 1;
        start = 0;
        stop = 0;

        // Test 1: Reset
        #10 rst = 0;

        // Test 2: IDLE hold
        #20;

        // Test 3: Start counting
        start = 1;
        #10 start = 0;

        // Test 4: Complete prime sequence
        repeat(6) #10;

        // Test 5: Check wraparound (13 -> 2)
        #10;

        // Test 6: Stop while ACTIVE
        stop = 1;
        #10 stop = 0;

        // Test 7: DONE -> IDLE
        #10;

        // Test 8: IDLE hold
        #20;

        // Test 9: Restart
        start = 1;
        #10 start = 0;

        // Test 10: Both start and stop high in ACTIVE
        stop = 1;
        start = 1;
        #10 stop = 0;
        start = 0;

        // Test 11: DONE -> IDLE after simultaneous inputs
        #20;

        $finish;
    end

endmodule
