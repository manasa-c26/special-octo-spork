`timescale 1ns/1ps

module tb_tensor_2;

    reg clk, rst;
    reg req_A, req_B;
    reg [7:0] data_A, data_B;

    wire grant_A, grant_B;
    wire [7:0] out_data;
    wire out_valid;

    integer i;

    tensor_2 uut (
        .clk(clk),
        .rst(rst),
        .req_A(req_A),
        .req_B(req_B),
        .data_A(data_A),
        .data_B(data_B),
        .grant_A(grant_A),
        .grant_B(grant_B),
        .out_data(out_data),
        .out_valid(out_valid)
    );

    always #5 clk = ~clk;

    initial begin

        $dumpfile("dump.vcd");
        $dumpvars(0, tb_tensor_2);

        clk = 0;
        rst = 1;
        req_A = 0;
        req_B = 0;
        data_A = 8'hAA;
        data_B = 8'hBB;

        // Reset
        @(posedge clk);
        #1;
        rst = 0;

        // Test 1: Only A requests
        req_A = 1;
        req_B = 0;
        @(posedge clk);
        #1;

        // Test 2: Only B requests
        req_A = 0;
        req_B = 1;
        @(posedge clk);
        #1;

        // Test 3: Both request
        req_A = 1;
        req_B = 1;

        @(posedge clk);
        #1;

        @(posedge clk);
        #1;

        // Test 4: Neither requests
        req_A = 0;
        req_B = 0;
        @(posedge clk);
        #1;

        // Test 5: Both requests held high for 20 cycles
        req_A = 1;
        req_B = 1;

        for (i = 0; i < 20; i = i + 1) begin
            @(posedge clk);
            #1;
        end

        $finish;

    end

endmodule
