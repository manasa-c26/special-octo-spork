`timescale 1ns/1ps

module tb_teensor_2;

    reg clk, rst;
    reg req_A, req_B;
    reg [7:0] data_A, data_B;

    wire grant_A, grant_B;
    wire [7:0] out_data;
    wire out_valid;

    integer i;
    integer count_B;

    teensor_2 uut (
        .clk(clk),
        .rst(rst),
        .req_A(req_A),
        .req_B(req_B),
        .data_A(data_A),
        .data_B(data_B),
        .grant_A(grant_A),
        .grant_B(grant_B),
        .out_data(out_data),
        .out_valid(out_valid)
    );

    always #5 clk = ~clk;

    task check;
        input expected_A;
        input expected_B;
        input [7:0] expected_data;
        input expected_valid;

        begin
            if (grant_A !== expected_A ||
                grant_B !== expected_B ||
                out_data !== expected_data ||
                out_valid !== expected_valid) begin

                $display("FAIL at time %0t", $time);
                $display("grant_A=%b grant_B=%b out_data=%h out_valid=%b",
                         grant_A, grant_B, out_data, out_valid);
                $finish;
            end
            else begin
                $display("PASS at time %0t", $time);
            end
        end
    endtask

    initial begin

        $dumpfile("dump.vcd");
        $dumpvars(0, tb_teensor_2);

        clk = 0;
        rst = 1;
        req_A = 0;
        req_B = 0;
        data_A = 8'hAA;
        data_B = 8'hBB;
        count_B = 0;

        // Reset
        @(posedge clk);
        #1;
        check(0, 0, 8'h00, 0);

        rst = 0;

        // Test 1: Only A requests
        req_A = 1;
        @(posedge clk);
        #1;
        check(1, 0, 8'hAA, 1);

        // Test 2: Only B requests
        req_A = 0;
        req_B = 1;
        @(posedge clk);
        #1;
        check(0, 1, 8'hBB, 1);

        // Test 3: Both request, A should win
        req_A = 1;
        req_B = 1;
        @(posedge clk);
        #1;
        check(1, 0, 8'hAA, 1);

        // Test 4: Neither requests
        req_A = 0;
        req_B = 0;
        @(posedge clk);
        #1;
        check(0, 0, 8'h00, 0);

        // Test 5: Both requests held high for 20 cycles
        req_A = 1;
        req_B = 1;

        for (i = 0; i < 20; i = i + 1) begin
            @(posedge clk);
            #1;
            check(1, 0, 8'hAA, 1);

            if (grant_B)
                count_B = count_B + 1;
        end

        $display("B grants in 20 cycles = %0d", count_B);

        if (count_B == 0)
            $display("PASS: B receives no grants in fixed-priority version");
        else
            $display("FAIL: B received unexpected grants");

        $display("ALL TESTS COMPLETED");
        $finish;

    end

endmodule
